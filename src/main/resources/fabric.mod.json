  "authors": ["The Create Team"],
  "contact": {
    "homepage": "https://github.com/minecraft-creatization/Ponder",
    "sources": "https://github.com/minecraft-creatization/Ponder"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.zurrtum.create.client.ponder.Ponder"
    ]
  },
  "accessWidener": "ponder.classtweaker",
